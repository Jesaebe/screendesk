#!/usr/bin/env bash
set -euo pipefail

config_file="${XDG_CONFIG_HOME:-$HOME/.config}/screendeck-home/kiosk.env"

if [[ ! -r "$config_file" ]]; then
  echo "Configuração ausente: $config_file" >&2
  exit 1
fi

# O arquivo é gerado pelo instalador, contém somente a URL LAN e não credenciais.
source "$config_file"

if [[ "${SCREENDECK_HA_URL:-}" != http://* && "${SCREENDECK_HA_URL:-}" != https://* ]]; then
  echo "SCREENDECK_HA_URL deve usar http:// ou https://" >&2
  exit 1
fi

# Reforço por sessão; as preferências persistentes são configuradas pelo instalador.
xset s off
xset -dpms
xset s noblank

while true; do
  if command -v firefox-esr >/dev/null; then
    MOZ_USE_XINPUT2=1 firefox-esr --kiosk "$SCREENDECK_HA_URL"
  elif command -v firefox >/dev/null; then
    MOZ_USE_XINPUT2=1 firefox --kiosk "$SCREENDECK_HA_URL"
  elif command -v chromium >/dev/null; then
    chromium --kiosk --no-first-run --disable-session-crashed-bubble --disable-features=Translate --ozone-platform=x11 "$SCREENDECK_HA_URL"
  else
    echo "Nenhum navegador compatível encontrado." >&2
    exit 1
  fi
  sleep 5
done
