# Copie para .env somente no servidor e restrinja com chmod 600.
TZ=America/Bahia
DASHBOARD_PORT=8123
DASHBOARD_USERNAME=admin
DASHBOARD_PUBLIC_URL=http://hml.cyrius.com.br
HOST_METRICS_INTERVAL_SECONDS=1
HOST_METRICS_HISTORY_INTERVAL_SECONDS=60
BACKUP_ROOT=/srv/backups
BACKUP_UID=1000
BACKUP_GID=1000
BACKUP_SCHEDULE=0 2 * * *
BACKUP_LOCAL_HIGH_WATERMARK=85
BACKUP_LOCAL_LOW_WATERMARK=75
BACKUP_CLOUD_RETENTION_DAYS=15
BACKUP_CONFIG=/run/secrets/sources.toml
BACKUP_CONFIG_HOST=./secrets/sources.toml
BACKUP_MAKER_PASSWORD_HOST=/home/cyrius/.config/screendeck-home/maker-password
RCLONE_CONFIG=/run/rclone/rclone.conf
RCLONE_CONFIG_DIR_HOST=/home/cyrius/.config/rclone
BACKUP_CLOUD_REMOTE=gdrive-crypt:screendeck-home
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD_FILE=/run/secrets/smtp-password
SMTP_PASSWORD_HOST=/home/cyrius/.config/screendeck-home/smtp-password
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
