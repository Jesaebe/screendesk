# Copie para .env somente no servidor e restrinja com chmod 600.
TZ=America/Bahia
HA_PORT=8123
BACKUP_ROOT=/srv/backups
BACKUP_SCHEDULE=0 2 * * *
BACKUP_LOCAL_HIGH_WATERMARK=85
BACKUP_LOCAL_LOW_WATERMARK=75
BACKUP_CLOUD_RETENTION_DAYS=15
BACKUP_CONFIG=/run/secrets/sources.toml
RCLONE_CONFIG=/run/secrets/rclone.conf
RCLONE_CRYPT_REMOTE=gdrive-crypt:screendeck-home
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Uma variável separada para cada origem. Nunca preencha neste arquivo versionado.
BACKUP_MAKER_PASSWORD=
BACKUP_NEW_DATABASE_PASSWORD=
